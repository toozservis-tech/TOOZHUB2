FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DATA_DIR_PATH=/tmp/toozhub-data
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-ces tesseract-ocr-eng chromium chromium-driver fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
COPY requirements-server.txt ./
RUN pip install --no-cache-dir -r requirements-server.txt
COPY src ./src
COPY web ./web
COPY web_admin ./web_admin
COPY VERSION ./VERSION
RUN useradd --create-home appuser \
    && install -d -o appuser -g appuser /app/public_share
USER appuser
CMD ["sh", "-c", "exec uvicorn src.server.main:app --host 0.0.0.0 --port ${PORT:-10000}"]
